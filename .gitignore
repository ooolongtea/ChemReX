# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/
miniforge3/

# ---- Secrets / env ----
.env
.env.*
!.env.example

# ---- Data (large datasets, not versioned) ----
data/raw/
data/processed/
data/outputs/
data/md/
data/pdf/
data/seed-*/

training/data/seed-*/

# ---- Run results / artifacts ----
results/
training/*-LoRA-*/

# ---- Request-timing probe runtime artifacts ----
# Raw request log is 2.3MB runtime data; report.md/summary.json keep the findings.
doc/request-timing-*/requests.jsonl
doc/request-timing-*/collector-pid.json
doc/request-timing-*/progress.json
doc/request-timing-*/state.json
doc/request-timing-*/window.json

# ---- Batch operation state (keep files locally for resume) ----
doc/pause-*/state.json
doc/pause-*/verification.json

# ---- Quality repair / acceptance runtime bundles ----
# Keep source, tests and concise reports in Git. PDFs, page images, raw model
# responses, inventories, scan lists and process state stay at their run paths.
doc/bug-localization-*/*.json

/doc/reaction-quality-repair-20261013/*
!/doc/reaction-quality-repair-20261013/bug-evidence.md
!/doc/reaction-quality-repair-20261013/confirmed-source-defects.json

/doc/reaction-quality-acceptance-handoff-20261015/*
!/doc/reaction-quality-acceptance-handoff-20261015/*.md
!/doc/reaction-quality-acceptance-handoff-20261015/build_evidence.py

/doc/production-repair-20261016/*
!/doc/production-repair-20261016/README.md
!/doc/production-repair-20261016/*.py

# ---- Eval outputs ----
eval/end2end/outputs/
eval/end2end/pred/
eval/end2end/gold/
eval/eval_reports/*.png
eval/eval_reports/*.pdf
eval/eval_reports/*.svg

# ---- Legacy local archive ----
MAReX_training_code/

# ---- Example run outputs ----
examples/**/pipeline_result.json
examples/**/pipeline_result_coref.json
examples/**/standardized.json
examples/**/standardized_coref.json
examples/**/image_only.json
examples/**/validation_result.json
examples/**/run_output_*/

# ---- Logs ----
*.log
logs/

