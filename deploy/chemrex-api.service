[Unit]
Description=ChemReX PDF upload API
After=network.target
Wants=chemrex-api-worker.service

[Service]
Type=simple
WorkingDirectory=/opt/chemrex
EnvironmentFile=%h/.config/chemrex-api.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env ${CHEMREX_TEXT_PYTHON} run_api.py
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=default.target
