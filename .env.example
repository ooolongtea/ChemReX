# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_V4_PRO_MODEL=deepseek-v4-pro

# Huawei ModelArts MaaS (full endpoint or SDK base URL both work)
MAAS_API_KEY=
MAAS_BASE_URL=https://api.modelarts-maas.com/v2/chat/completions
MAAS_MODEL=deepseek-v4.1-flash

# ChatGPT / OpenAI
CHATGPT_API_KEY=
CHATGPT_BASE_URL=https://api.openai.com/v1
CHATGPT_MODEL=gpt-4o

# Generic fallback used by older entry points.
# Leave empty if using provider-specific keys above.
API_KEY=
BASE_URL=

# Module defaults
EXTRACTION_PRESET=deepseek-v4-pro
EXTRACTION_MODEL=deepseek-v4-pro
STANDARDIZE_MODEL=gpt-4o
COREF_MODEL=gpt-4o

# Batch M1 routing by document language. Chinese uses the local
# Qwen3-8B + LoRA adapter (training-aligned v1 prompts); English keeps MaaS.
# M3/M4/final-product stay on BATCH_LLM_PROVIDER/BATCH_LLM_MODEL.
BATCH_EXTRACTION_PRESET_ZH=qwen3-lora-08
BATCH_EXTRACTION_PRESET_EN=huawei-maas
# Optional overrides for the local vLLM qwen3-lora-08 endpoint.
QWEN3_LORA_BASE_URL=http://localhost:8050/v1
QWEN3_LORA_API_KEY=token-abc123
# Document-level final product extraction (abstract region, route direction)
FINAL_PRODUCT_MODEL=gpt-4o
# Optional explicit provider for M3: maas, deepseek, chatgpt, generic
STANDARDIZE_PROVIDER=
COREF_PROVIDER=
FINAL_PRODUCT_PROVIDER=
STANDARDIZE_NETWORK_TIMEOUT=8

# PDF upload API (uses its own task database, separate from local batch jobs)
CHEMREX_API_DATA_ROOT=/data/patents/chemrex_batch/api
CHEMREX_API_HOST=127.0.0.1
CHEMREX_API_PORT=9250
CHEMREX_API_MAX_UPLOAD_MB=200
CHEMREX_API_TASK_WORKERS=1
# Optional override, colon-separated task databases for same-PDF reuse.
# API defaults: the historical ../tasks.db and its own tasks.db (grows automatically).
# CHEMREX_REUSE_TASK_DATABASES=/data/chemrex_batch/tasks.db:/data/chemrex_batch/api/tasks.db
# For deploy/*.service, set this to the existing text environment's Python.
CHEMREX_TEXT_PYTHON=/path/to/retroparser/bin/python
